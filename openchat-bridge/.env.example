PORT=8090
DATABASE_URL=postgres://openchat:openchat@localhost:5432/openchat_bridge
OPENCHAT_SECRET=replace-with-32-byte-secret
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_PLATFORM_TOKEN=
# Shared secret sent as X-Openchat-Bridge-Secret when calling into Rails' internal
# openchat_tools endpoints (e.g. admin-copilot tool calls). Must match Chatwoot's
# OPENCHAT_BRIDGE_INTERNAL_SECRET.
OPENCHAT_BRIDGE_INTERNAL_SECRET=dev-bridge-internal-secret
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_GATEWAY_IMAGE=openclaw:local
# Directory with identity/ + devices/paired.json (operator.admin). Same user as openclaw-gateway.
OPENCLAW_STATE_DIR=
OPENCHAT_BRIDGE_PUBLIC_URL=http://localhost:8090
# shared: one gateway/WhatsApp number/memory store for every tenant (dev only).
# fleet: one isolated `openclaw fleet` cell per tenant (own WhatsApp number, own memory).
#   Requires: this bridge running as a NATIVE process on the Fleet host (not containerized —
#   operator.admin needs a real 127.0.0.1 connection to each cell), docker on PATH, and
#   OPENCLAW_FLEET_RUNNER_IMAGE built (see deploy/fleet-runner/Dockerfile).
GATEWAY_POOL_MODE=shared
OPENCLAW_FLEET_RUNNER_IMAGE=openclaw-fleet-runner:local
STRIPE_WEBHOOK_SECRET=
RATE_LIMIT_PER_MINUTE=30
