{
  "name": "openchat-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenChat orchestrator between Chatwoot and OpenClaw",
  "scripts": {
    "start": "node --env-file=.env --experimental-strip-types src/index.ts",
    "dev": "node --watch --env-file=.env --experimental-strip-types src/index.ts",
    "test": "node --experimental-strip-types --test src/services/handoff.test.ts src/services/rate-limit.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "fastify": "^5.2.1",
    "pg": "^8.13.3",
    "ws": "^8.18.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.11.11",
    "@types/ws": "^8.18.0"
  }
}
